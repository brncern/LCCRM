# --- Supabase (veritabanı + giriş) ---
# Boş bırakırsan uygulama "örnek veri" modunda, girişsiz açılır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda kullanılır (senkron işleri ve webhook'lar için). Asla istemciye gönderme.
SUPABASE_SERVICE_ROLE_KEY=

# Giriş yapabilecek tek e-posta (virgülle birden fazla yazılabilir)
ALLOWED_EMAILS=

# Uygulamanın adresi (giriş linki dönüşü için), ör. https://crm.lawchat.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 2. aşama: reklamlar (şimdilik boş kalabilir) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- 5. aşama: Grafana ---
GRAFANA_URL=
GRAFANA_TOKEN=
